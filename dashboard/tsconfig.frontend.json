{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "outDir": "./dist/frontend",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/frontend/**/*.ts", "src/frontend/**/*.tsx"],
  "references": []
}
